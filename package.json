{
    "name": "rk-furnishings",
    "version": "1.0.0",
    "scripts": {
        "build": "npm run build --prefix frontend",
        "start": "concurrently \"npm run dev --prefix frontend\" \"node backend/server.js\"",
        "dev": "concurrently \"npm run dev --prefix frontend\" \"node backend/server.js\"",
        "seed": "node backend/seed.js",
        "backend": "node backend/server.js",
        "install-all": "npm install --prefix frontend && npm install --prefix backend"
    },
    "dependencies": {
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}